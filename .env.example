# The base URL of your application (e.g., http://localhost:3000)
NEXT_PUBLIC_APP_URL="YOUR_APP_URL"

# PostgreSQL connection string (Neon or standard Postgres)
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# Secret key for signing JWT tokens. Use a long random string.
JWT_SECRET="YOUR_JWT_SECRET"

# Email mode: "restrict" to only allow specific domains, or "public"
AUTH_EMAIL_MODE="restrict"

# List of allowed email domains separated by commas (e.g., university.ac.id,gmail.com)
AUTH_ALLOWED_EMAIL_DOMAINS="university.ac.id"

# Microsoft Entra ID (Azure AD) Tenant ID
MICROSOFT_OAUTH_TENANT_ID="YOUR_TENANT_ID"

# Microsoft Entra ID (Azure AD) Client ID
MICROSOFT_OAUTH_CLIENT_ID="YOUR_CLIENT_ID"

# Microsoft Entra ID (Azure AD) Client Secret
MICROSOFT_OAUTH_CLIENT_SECRET="YOUR_CLIENT_SECRET"

# Google OAuth Client ID
GOOGLE_OAUTH_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"

# Google OAuth Client Secret
GOOGLE_OAUTH_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# Threshold for warning when OAuth response is slow (ms)
AUTH_OAUTH_LATENCY_WARN_MS=3000

# Enable detailed timing logs for OAuth flow (true/false)
AUTH_OAUTH_DEBUG_TIMING=false

# Number of days to keep system logs
LOG_RETENTION_DAYS=30

# Maximum number of log records to store
LOG_MAX_RECORDS=50000